{
  "name": "comfy-pocket",
  "version": "0.1.3",
  "description": "A lightweight, mobile-friendly app runner for your ComfyUI backend",
  "type": "module",
  "bin": {
    "comfy-pocket": "cli/index.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SquirrelSong5/comfy-pocket.git"
  },
  "files": [
    "cli/",
    "backend/*.py",
    "web/dist/",
    "requirements.txt",
    "README.md",
    "README.en.md",
    "docs/screenshots/*.png",
    "docs/guide.*.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "THIRD_PARTY_LICENSES.txt"
  ],
  "scripts": {
    "build": "node scripts/build-package.mjs",
    "prepare": "node scripts/build-package.mjs",
    "test": "node --test tests/*.test.mjs"
  }
}
